# copy to .env and fill in, .env is git-ignored, never commit real values

# required, from the claude console, keep it secret
ANTHROPIC_API_KEY=

# llm settings, defaults match app/services/llm_agent.py
LLM_MODEL=claude-sonnet-5-5
# one of low, medium, high
LLM_EFFORT=medium

# required by the nominatim and overpass usage policies: name the app and give a contact
# example: TrueRoute-AI/0.1 (you@example.com)
APP_USER_AGENT=

# public osm servers by default, switchable without code changes as the policies require
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OVERPASS_BASE_URL=https://overpass-api.de/api

# DEBUG, INFO, WARNING or ERROR, the anthropic sdk is kept at WARNING regardless
LOG_LEVEL=INFO