# copy to .env and fill in, .env is git-ignored, never commit real values

# required, from the claude console, keep it secret
ANTHROPIC_API_KEY=

# llm settings, defaults match app/services/llm_agent.py
LLM_MODEL=claude-sonnet-5-5
# one of low, medium, high
LLM_EFFORT=medium

# required by the nominatim and overpass usage policies: name the app and give a contact
# example: TrueRoute-AI/0.1 (you@example.com)
APP_USER_AGENT=

# public osm servers by default, switchable without code changes as the policies require
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OVERPASS_BASE_URL=https://overpass-api.de/api

# optional, free key from openrouteservice.org, keep it secret, empty means aerial distances only
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org

# backup walking routes when ors is down or has no key, true or false
# public fossgis server: at most one request per second, no heavy use
OSRM_ENABLED=true
OSRM_BASE_URL=https://routing.openstreetmap.de

# optional, when set visitors must type this code, 8 to 200 printable ascii characters, no spaces
DEMO_ACCESS_CODE=
# per client address per hour, and for all clients per rolling 24 hours
RATE_LIMIT_PER_IP_HOUR=5
DAILY_ITINERARY_CAP=100

# optional, postgres for user accounts, keep it secret, it holds the database password
# example for docker compose: postgresql+asyncpg://trueroute:your-password@localhost:5432/trueroute
DATABASE_URL=

# optional, cloudflare turnstile for the human check on sign-up and after failed sign-ins
# both or neither; the site key is public, keep the secret key secret
# local development: cloudflare's official test keys always pass and show a test banner
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# production: create a widget at dash.cloudflare.com, never ship the test keys
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# key that protects one-time codes, keep it secret, at least 32 characters
# generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
# accounts switch on when DATABASE_URL, the turnstile keys and this key are all set
OTP_HMAC_KEY=

# DEBUG, INFO, WARNING or ERROR, the anthropic sdk is kept at WARNING regardless
LOG_LEVEL=INFO